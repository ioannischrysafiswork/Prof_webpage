# Private raw inputs (CVs, theses, certificates) — never published.
# Only the README explaining what to put there is committed.
source-material/*
!source-material/README.md

# Dependencies & build output
node_modules/
dist/
.astro/

# QA artefacts (screenshots, Lighthouse reports, Playwright MCP snapshots)
.qa/
.playwright-mcp/

# Secrets & local config
.env
.env.*
.claude/settings.local.json

# Logs & OS files
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# Python (scientific-figures)
__pycache__/
.venv/
