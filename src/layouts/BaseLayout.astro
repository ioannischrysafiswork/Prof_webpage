---
/**
 * Base layout for every page: <head> (SEO, favicon, sitemap, LCP font preload, no-flash
 * theme script, view transitions), skip link, sticky header with the three-area
 * navigation, <main id="main">, the shared footer, and a print-only CV masthead.
 *
 * <main> is full-width: frame content with <Section>/<PageHeader> (which include the
 * page container) or the `container-page` utility.
 * Slots: default (page content), "head" (extra <head> tags, e.g. JSON-LD).
 */
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SEO from '@/components/layout/SEO.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import ThemeScript from '@/components/layout/ThemeScript.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PrintMasthead from '@/components/layout/PrintMasthead.astro';
import { getProfile } from '@/lib/profile';
import { OG_IMAGES, type PageKey } from '@/lib/site';
import { url } from '@/lib/url';

interface Props {
  /** Which area this page belongs to; supplies default SEO text, nav state and tint. */
  page?: PageKey;
  /** Site path of this page, e.g. '/work' (for the canonical URL). */
  path: string;
  /**
   * Override the per-page title / description from profile.yaml → seo. A title that does
   * not already contain the person's name gets the suffix " — <name>" (e.g. the 404 page).
   */
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const profile = await getProfile();

const { page, path, noindex = false } = Astro.props;
const seo = page ? profile.seo[page] : undefined;
const titleBase = Astro.props.title ?? seo?.title ?? profile.name;
const title = titleBase.includes(profile.name) ? titleBase : `${titleBase} — ${profile.name}`;
const description = Astro.props.description ?? seo?.description ?? profile.seo.home.description;
const ogImage = Astro.props.ogImage ?? OG_IMAGES[page ?? 'home'];
---

<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeScript />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload only the font that renders the LCP element (the Inter intro paragraph on
         every page). Newsreader (headings) and JetBrains Mono (labels) are discovered from
         the stylesheet so they do not compete with it for bandwidth on mobile. -->
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <SEO
      title={title}
      siteName={profile.name}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      type={page === 'home' ? 'profile' : 'website'}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Header current={page} siteName={profile.name} />
    <main id="main" tabindex="-1">
      <PrintMasthead profile={profile} path={path} />
      <slot />
    </main>
    <Footer profile={profile} current={page} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
