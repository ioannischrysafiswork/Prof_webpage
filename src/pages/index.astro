---
/**
 * Home — `/` (CLAUDE.md §2.1). Permanent route.
 * Stable anchors: #about, #highlights, #explore, #interests.
 *
 * 1. Hero: name, headline, personal intro (profile.yaml), quick links to the two areas.
 * 2. Highlights: featured degrees, roles, certifications, achievements (shared collections).
 * 3. Explore: large entry cards to Work Experience and Academic.
 * 4. Beyond work & academia: interests.yaml.
 * Contact lives in the shared Footer.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeHighlights from '@/components/home/HomeHighlights.astro';
import EntryCards from '@/components/home/EntryCards.astro';
import HomeInterests from '@/components/home/HomeInterests.astro';
import HomeJsonLd from '@/components/home/HomeJsonLd.astro';
import { getEntryPreviews, getHighlights } from '@/components/home/data';
import { getProfile } from '@/lib/profile';

const path = '/';
const [profile, highlights, previews] = await Promise.all([
  getProfile(),
  getHighlights(),
  getEntryPreviews(),
]);
---

<BaseLayout page="home" path={path}>
  <HomeJsonLd slot="head" profile={profile} path={path} />
  <HomeHero profile={profile} />
  <HomeHighlights items={highlights} />
  <EntryCards previews={previews} />
  <HomeInterests />
</BaseLayout>
