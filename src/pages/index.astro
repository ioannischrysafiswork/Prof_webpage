---
/**
 * Home — `/` (CLAUDE.md §2.1). Permanent route.
 * Skeleton wired to the design system: home-page-builder fills in each section.
 * Stable anchors: #about, #highlights, #explore, #interests.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import { getProfile } from '@/lib/profile';
import { NAV } from '@/lib/site';
import { url } from '@/lib/url';

const profile = await getProfile();
const entryPoints = NAV.filter((item) => item.key !== 'home');
---

<BaseLayout page="home" path="/">
  <PageHeader id="about" title={profile.name} lede={profile.headline}>
    <p>{profile.intro.home}</p>
  </PageHeader>

  <Section id="highlights" eyebrow="At a glance" title="Highlights">
    {/* Degrees, key certifications, achievements — featured entries from the collections. */}
  </Section>

  <Section id="explore" eyebrow="Explore" title="Explore">
    <ul class="grid gap-6 md:grid-cols-2">
      {entryPoints.map((item) => (
        <Card
          as="li"
          variant="feature"
          tint={item.key}
          title={item.label}
          headingLevel={3}
          href={url(item.path)}
        >
          <p>{item.description}</p>
        </Card>
      ))}
    </ul>
  </Section>

  <Section id="interests" eyebrow="Outside work" title="Outside work">
    {/* Hobbies and interests from interests.yaml. */}
  </Section>
</BaseLayout>
