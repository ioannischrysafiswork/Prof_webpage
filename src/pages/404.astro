---
/**
 * 404 — links back to all three areas (CLAUDE.md §3.1). GitHub Pages serves dist/404.html.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import { NAV } from '@/lib/site';
import { url } from '@/lib/url';
---

<BaseLayout
  path="/404"
  title="Page not found"
  description="The page you were looking for does not exist. Continue to Home, Work Experience or Academic."
  noindex
>
  <PageHeader id="not-found" eyebrow="Error 404" title="Page not found">
    <p>The page you were looking for does not exist or has moved.</p>
    <ul slot="actions" class="flex flex-wrap gap-3">
      {NAV.map((item, index) => (
        <li>
          <LinkButton
            href={url(item.path)}
            variant={index === 0 ? 'primary' : 'secondary'}
            icon="lucide:arrow-right"
          >
            {item.label}
          </LinkButton>
        </li>
      ))}
    </ul>
  </PageHeader>
</BaseLayout>
