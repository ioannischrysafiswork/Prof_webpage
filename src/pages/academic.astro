---
/**
 * Academic — `/academic` (CLAUDE.md §2.3). Permanent route, printed in academic CVs.
 * Skeleton wired to the design system: academic-page-builder fills in each section.
 * Stable anchors: #about, #roadmap, #degrees (#bachelor-degree, #master-degree),
 * #qualifications, #theses (#bachelor-thesis, #master-thesis), #projects, #other.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Timeline from '@/components/timeline/Timeline.astro';
import TimelineItem from '@/components/timeline/TimelineItem.astro';
import { getProfile } from '@/lib/profile';
import { sortByDateAsc } from '@/lib/dates';

const profile = await getProfile();
const roadmap = sortByDateAsc(await getCollection('education'), (entry) => entry.data);
---

<BaseLayout page="academic" path="/academic">
  <PageHeader id="about" eyebrow={profile.name} title="Academic" lede={profile.headline}>
    <p>{profile.intro.academic}</p>
  </PageHeader>

  <Section id="roadmap" eyebrow="Path" title="Academic roadmap">
    <Timeline label="Academic roadmap, in chronological order">
      {roadmap.map(({ data }) => (
        <TimelineItem
          title={data.degree}
          subtitle={data.institution}
          meta={[data.location]}
          start={data.start}
          end={data.end}
          summary={data.summary}
          highlights={data.highlights}
          tech={data.tech}
        />
      ))}
    </Timeline>
  </Section>

  <Section id="degrees" eyebrow="Education" title="Degrees">
    <Section id="bachelor-degree" as="article" level={3} title="Bachelor's degree" />
    <Section id="master-degree" as="article" level={3} title="Master's degree" />
  </Section>

  <Section id="qualifications" eyebrow="Further study" title="Other qualifications" />

  <Section id="theses" eyebrow="Research" title="Theses">
    <Section id="bachelor-thesis" as="article" level={3} title="Bachelor's thesis" />
    <Section id="master-thesis" as="article" level={3} title="Master's thesis" />
  </Section>

  <Section id="projects" eyebrow="Computation" title="Projects & simulations" />

  <Section id="other" eyebrow="Beyond coursework" title="Other academic work" />
</BaseLayout>
