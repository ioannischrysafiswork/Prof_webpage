---
/**
 * Grid of curated projects for /work (#projects). Order: `order` ascending (curation),
 * then most recent first. 1 → 2 → 3 columns on screen. Print: a compact ledger, one entry
 * per project (title and dates on one line, then the tagline and the repository URL);
 * no card frames, thumbnails or stack chips.
 */
import type { CollectionEntry } from 'astro:content';
import { sortByDateDesc } from '@/lib/dates';
import ProjectCard from './ProjectCard.astro';

interface Props {
  entries: readonly CollectionEntry<'projects'>[];
}

const { entries } = Astro.props;
const projects = sortByDateDesc(entries, ({ data }) => data).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<ul class="projects" aria-label="Selected projects">
  {projects.map((entry) => (
    <ProjectCard entry={entry} />
  ))}
</ul>

<style>
  .projects {
    display: grid;
    gap: var(--space-lg);
  }

  @media (width >= 48rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media print {
    .projects {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .projects :global(.card) {
      border: 0;
      break-inside: avoid;
    }

    .projects :global(.card__media),
    .projects :global(.chip-list) {
      display: none;
    }

    .projects :global(.card__content) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 0 var(--space-md);
      padding: 0;
    }

    .projects :global(.card__title) {
      font-size: var(--text-base);
      line-height: var(--text-base--line-height);
      font-weight: 600;
    }

    .projects :global(.card__meta) {
      text-align: right;
    }

    .projects :global(.card__body),
    .projects :global(.card__footer) {
      grid-column: 1 / -1;
      font-size: var(--text-sm);
      line-height: var(--text-sm--line-height);
    }

    .projects :global(.card__footer) {
      gap: 0 var(--space-md);
      padding-top: 0;
    }

    /* Links print as plain "Repository <https://…>" text, not boxed buttons. */
    .projects :global(.btn) {
      display: inline;
      min-height: auto;
      padding: 0;
      border: 0;
      background: none;
      font-size: var(--text-xs);
      white-space: normal;
    }

    .projects :global(.btn__icon) {
      display: none;
    }
  }
</style>
