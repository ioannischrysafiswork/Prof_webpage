---
/**
 * One curated project on /work: optional thumbnail (images[0]), title, one-line problem
 * statement (tagline), optional summary, stack chips, and repo / demo links.
 * The meta line shows the project dates. The stack comes only from the content `tech`
 * list (no GitHub API metadata: a repo's "primary language" can mislead, e.g. a SQL
 * export, and fetching at build time made the output depend on the network).
 * Print keeps the CV essentials: title, dates, tagline and link URLs.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Card from '@/components/ui/Card.astro';
import ChipList from '@/components/ui/ChipList.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import { formatRange, isTodo } from '@/lib/dates';
import { hasValue, resolveLinks } from './links';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { data } = entry;

const links = resolveLinks(data.links, { order: ['repo', 'demo', 'code', 'report', 'pdf'] });
const meta =
  data.start && !isTodo(data.start) && !isTodo(data.end) ? formatRange(data.start, data.end) : '';

const cover = data.images[0];
const title = data.title;
---

<Card as="li" title={title} meta={meta || undefined} class="work-project">
  {cover && (
    <Fragment slot="media">
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[480, 800]}
        sizes="(min-width: 76rem) 24rem, (min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 100vw"
        class="work-project__image"
      />
    </Fragment>
  )}
  <p class="project__tagline">{data.tagline}</p>
  {data.summary && <p class="work-project__summary">{data.summary}</p>}
  <ChipList
    items={data.tech}
    size="sm"
    label={hasValue(title) ? `Stack: ${title}` : 'Stack'}
    class="work-project__stack"
  />
  {links.length > 0 && (
    <Fragment slot="footer">
      {links.map((link) => (
        <LinkButton href={link.href} size="sm">
          {link.label}
          <span class="sr-only">: {title}</span>
        </LinkButton>
      ))}
    </Fragment>
  )}
</Card>

<style>
  .project__tagline {
    color: var(--color-foreground);
  }

  :global(.work-project__stack) {
    margin-top: var(--space-sm);
  }

  :global(.work-project__image) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media print {
    /* Stack chips are hidden by ProjectGrid (it wins over ChipList's scoped styles). */
    .work-project__summary {
      display: none;
    }
  }
</style>
