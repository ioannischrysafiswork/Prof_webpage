---
/**
 * One role on the /work timeline: a <TimelineItem> fed from an `experience` entry.
 * Details (highlights, tech, links, Markdown body) are always shown on /work
 * (`collapsible={false}`) so recruiters and printed CVs see everything at once.
 * The organisation's website (links.website) links the organisation name itself.
 */
import { render, type CollectionEntry } from 'astro:content';
import TimelineItem from '@/components/timeline/TimelineItem.astro';
import Prose from '@/components/ui/Prose.astro';
import { hasValue, resolveLinks } from './links';

interface Props {
  entry: CollectionEntry<'experience'>;
  headingLevel?: 3 | 4;
}

const { entry, headingLevel = 3 } = Astro.props;
const { data } = entry;

const websiteLabel = '__organisation-website__';
const resolved = resolveLinks(data.links, { labels: { website: websiteLabel } });
const website = hasValue(data.organisation)
  ? resolved.find(({ label }) => label === websiteLabel)?.href
  : undefined;
const links = resolved
  .filter(({ label }) => label !== websiteLabel || !website)
  .map(({ label, href }) => ({
    label: label === websiteLabel ? 'Organisation website' : label,
    href,
  }));

// Render the Markdown body only when there is one, so empty entries add no empty block.
const hasBody = Boolean(entry.body?.trim());
const Content = hasBody ? (await render(entry)).Content : undefined;

const item = {
  title: data.role,
  subtitle: data.organisation,
  subtitleHref: website,
  meta: [data.location, data.employmentType],
  start: data.start,
  end: data.end,
  showDuration: true,
  summary: data.summary,
  highlights: data.highlights,
  tech: data.tech,
  techLabel: hasValue(data.role) ? `Tools and technologies: ${data.role}` : undefined,
  links,
  collapsible: false,
  headingLevel,
};
---

{Content ? (
  <TimelineItem {...item}>
    <Prose class="experience-body">
      <Content />
    </Prose>
  </TimelineItem>
) : (
  <TimelineItem {...item} />
)}
