---
/**
 * Key figure of a thesis or academic project: <figure> + optimised image + caption.
 * Images come from content (`images[0]`, processed by astro:assets). SVG figures are
 * passed through untouched; raster figures get responsive AVIF/WebP-ready sizes.
 *
 * NOTE: kept deliberately small. When science-visuals' `Figure` component lands in
 * src/components/science/, this wrapper can delegate to it without changing callers.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: { src: ImageMetadata; alt: string; caption?: string };
  /** Caption prefix, e.g. "Figure 1." (optional). */
  label?: string;
  /** `sizes` attribute for raster images. */
  sizes?: string;
  /** Tighter styling for use inside cards (no caption rule). */
  compact?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  label,
  sizes = '(min-width: 76rem) 48rem, (min-width: 48rem) 70vw, 100vw',
  compact = false,
  loading = 'lazy',
  class: className,
} = Astro.props;

const isSvg = image.src.format === 'svg';
const widths = isSvg
  ? undefined
  : [480, 800, 1200, 1600].filter((width) => width <= image.src.width * 1.01);
---

<figure class:list={['key-figure', { 'key-figure--compact': compact }, className]}>
  <div class="key-figure__frame">
    {isSvg ? (
      <Image src={image.src} alt={image.alt} loading={loading} class="key-figure__img" />
    ) : (
      <Image
        src={image.src}
        alt={image.alt}
        widths={widths && widths.length > 0 ? widths : undefined}
        sizes={widths && widths.length > 0 ? sizes : undefined}
        loading={loading}
        class="key-figure__img"
      />
    )}
  </div>
  {(image.caption || label) && (
    <figcaption class="key-figure__caption">
      {label && <span class="key-figure__label">{label}</span>} {image.caption}
    </figcaption>
  )}
</figure>

<style>
  .key-figure {
    display: grid;
    gap: var(--space-xs);
    max-width: 48rem;
  }

  .key-figure__frame {
    overflow: hidden;
    border: var(--rule-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .key-figure--compact {
    max-width: none;
  }

  .key-figure--compact .key-figure__frame {
    border: 0;
    border-radius: 0;
    background: none;
  }

  .key-figure__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .key-figure__caption {
    max-width: var(--container-measure);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-muted);
  }

  .key-figure__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  @media print {
    .key-figure {
      max-width: 60%;
    }

    .key-figure--compact {
      max-width: none;
    }

    .key-figure__frame {
      border-radius: 0;
    }
  }
</style>
