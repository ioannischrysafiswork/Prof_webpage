---
/**
 * Shared footer — makes every page self-sufficient (CLAUDE.md §2): who this is, how to
 * get in touch (profile.yaml → contact, socials, cv), cross-links to all three areas,
 * and the last-updated date (build date).
 * `TODO(ioannis)` values are skipped here: placeholders belong in page content, not chrome.
 * In print the name/contact/sections grid is hidden (the print masthead already carries
 * name and contact details, so they are not printed twice); only a one-line meta row
 * (copyright, last updated) remains.
 */
import { Icon } from 'astro-icon/components';
import { formatDate, isTodo } from '@/lib/dates';
import type { Profile } from '@/lib/profile';
import { NAV, type PageKey } from '@/lib/site';
import { absoluteUrl, url } from '@/lib/url';

interface Props {
  profile: Profile;
  /** Current area, for aria-current on the cross-links. */
  current?: PageKey;
}

const { profile, current } = Astro.props;

const show = (value: string | undefined | null): value is string =>
  typeof value === 'string' && value.trim() !== '' && !isTodo(value);

const email = show(profile.contact.email) ? profile.contact.email : undefined;
const socials = profile.socials.filter((social) => show(social.url));
const documents = [
  { label: 'CV — Work (PDF)', href: profile.cv.work },
  { label: 'CV — Academic (PDF)', href: profile.cv.academic },
].filter((doc): doc is { label: string; href: string } => show(doc.href));
const headline = show(profile.headline) ? profile.headline : undefined;
const location = show(profile.location) ? profile.location : undefined;

const now = new Date();
const updatedIso = now.toISOString().slice(0, 10);
const updatedLabel = formatDate(updatedIso.slice(0, 7));
const year = now.getFullYear();
---

<footer class="site-footer">
  <div class="container-page site-footer__grid">
    <section class="site-footer__about" aria-labelledby="footer-contact-title">
      <p class="site-footer__name">{profile.name}</p>
      {headline && <p class="site-footer__headline">{headline}</p>}
      {location && <p class="site-footer__location">{location}</p>}

      <h2 id="footer-contact-title" class="site-footer__label">
        Contact
      </h2>
      <ul class="site-footer__links">
        {email && (
          <li>
            <a href={`mailto:${email}`} class="site-footer__link">
              <Icon name="lucide:mail" class="site-footer__icon" aria-hidden="true" />
              <span>{email}</span>
            </a>
          </li>
        )}
        {socials.map((social) => (
          <li>
            <a href={url(social.url)} rel="me noopener" class="site-footer__link">
              <Icon
                name={social.icon ?? 'lucide:link'}
                class="site-footer__icon"
                aria-hidden="true"
              />
              <span>{social.label}</span>
            </a>
          </li>
        ))}
        {documents.map((doc) => (
          <li>
            <a
              href={url(doc.href)}
              class="site-footer__link"
              data-print-url={absoluteUrl(doc.href)}
            >
              <Icon name="lucide:file-text" class="site-footer__icon" aria-hidden="true" />
              <span>{doc.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <nav class="site-footer__sections" aria-labelledby="footer-sections-title">
      <h2 id="footer-sections-title" class="site-footer__label">
        Sections
      </h2>
      <ul class="site-footer__nav">
        {NAV.map((item) => (
          <li>
            <a
              href={url(item.path)}
              class="site-footer__nav-link"
              data-tint={item.key}
              aria-current={item.key === current ? 'page' : undefined}
            >
              <span class="site-footer__nav-label">{item.label}</span>
              <span class="site-footer__nav-desc">{item.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container-page site-footer__meta">
    <div class="site-footer__meta-inner">
      <p>
        &copy; {year} {profile.name}
      </p>
      <p>
        Last updated <time datetime={updatedIso}>{updatedLabel}</time>
      </p>
      <p data-print="hide">
        <a href="#main" class="site-footer__top">
          Back to top
          <Icon name="lucide:arrow-up" class="site-footer__icon" aria-hidden="true" />
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--spacing-section);
    border-top: var(--rule-width) solid var(--color-border);
    background-color: var(--color-background);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  @media (width >= 48rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .site-footer__name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    color: var(--color-foreground);
  }

  .site-footer__headline {
    margin-top: var(--space-2xs);
  }

  .site-footer__location {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .site-footer__label {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: var(--text-xs--line-height);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-footer__sections .site-footer__label {
    margin-top: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
  }

  .site-footer__link,
  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--size-target);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-footer__link:hover span,
  .site-footer__top:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .site-footer__icon {
    width: var(--size-icon);
    height: var(--size-icon);
    flex: none;
    color: var(--color-muted);
  }

  .site-footer__nav {
    display: grid;
    border-top: var(--rule-width) solid var(--color-border);
  }

  .site-footer__nav-link {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-sm);
    padding-left: var(--space-md);
    border-bottom: var(--rule-width) solid var(--color-border);
    border-left: var(--rule-width-strong) solid transparent;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  @media (width >= 40rem) {
    .site-footer__nav-link {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-md);
    }
  }

  .site-footer__nav-link:hover,
  .site-footer__nav-link[aria-current='page'] {
    border-left-color: var(--tint);
  }

  .site-footer__nav-label {
    font-weight: 500;
    color: var(--color-foreground);
  }

  .site-footer__meta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    padding-block: var(--space-md);
    border-top: var(--rule-width) solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .site-footer__top {
    min-height: auto;
    color: var(--color-muted);
  }

  .site-footer__top:hover {
    color: var(--color-foreground);
  }

  @media print {
    .site-footer {
      border-top: none;
      break-inside: avoid;
    }

    .site-footer__meta-inner {
      justify-content: flex-start;
      padding-block: var(--space-xs) 0;
    }
  }
</style>
