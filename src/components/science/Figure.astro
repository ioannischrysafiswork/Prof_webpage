---
/**
 * Figure: a numbered, captioned <figure> for theses and academic work.
 *
 * Media (one of):
 *   - `src`: an astro:assets image (import from src/assets/…) → responsive AVIF/WebP <img>
 *   - `svg`: a raw SVG string (`import plot from '@/assets/science/x.svg?raw'`), inlined so
 *     `currentColor` / `var(--plot-N)` follow the theme (see PlotEmbed for plots)
 *   - default slot: any other media, e.g. <SimulationCanvas> or a <video>
 *
 *   <Figure src={spectrum} alt="…what the image shows…" number={2} caption="…" credit="…" />
 *
 * Click-to-enlarge (images and SVG) opens a native modal <dialog>: Escape, the close
 * button or a click on the backdrop closes it, and focus returns to the enlarge button.
 * The larger image is only downloaded when the dialog opens. Without JS the figure is
 * simply not enlargeable. Numbering is explicit (`number`) so figure references stay stable.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { prepareSvg } from './svg';

interface Props {
  /** Image asset from astro:assets (raster or SVG file). */
  src?: ImageMetadata;
  /** Raw SVG markup to inline (theme-aware figures). */
  svg?: string;
  /** Text alternative describing what the figure shows (required, not a repeat of the caption). */
  alt: string;
  /** Caption text. For rich captions (maths, links) use the "caption" slot instead. */
  caption?: string;
  /** Figure number → "Figure 2." prefix. Omit for an unnumbered figure. */
  number?: number | string;
  /** Word before the number. Default "Figure". */
  prefix?: string;
  /** Source / credit line, e.g. "Simulation output, master's thesis (2024)". */
  credit?: string;
  /** Optional link for the credit. */
  creditHref?: string;
  /** Stable anchor, e.g. "fig-phase-diagram". */
  id?: string;
  /** Offer click-to-enlarge. Default true for `src` / `svg`, always false for slot media. */
  enlarge?: boolean;
  /** Surface, hairline border and padding around the media. Default true. */
  framed?: boolean;
  /** Image loading. Use "eager" only for a figure above the fold. Default "lazy". */
  loading?: 'lazy' | 'eager';
  /** `sizes` for the inline image. Default fits the 70ch prose column. */
  sizes?: string;
  /** Extra class on the media box (e.g. PlotEmbed's "figure__media--plot"). */
  mediaClass?: string;
  class?: string;
}

const {
  src,
  svg,
  alt,
  caption,
  number,
  prefix = 'Figure',
  credit,
  creditHref,
  id,
  framed = true,
  loading = 'lazy',
  sizes = '(min-width: 48rem) 42rem, 100vw',
  mediaClass,
  class: className,
} = Astro.props;

if (src && svg) throw new Error('<Figure>: pass either `src` or `svg`, not both.');
if (!alt?.trim()) throw new Error('<Figure>: `alt` is required and must describe the figure.');

const hasMedia = Boolean(src || svg);
const enlarge = hasMedia && (Astro.props.enlarge ?? true);
const inlineSvg = svg ? prepareSvg(svg) : undefined;
const numberLabel = number !== undefined && number !== '' ? `${prefix} ${number}` : undefined;
const hasCaption = Boolean(caption || numberLabel || credit || Astro.slots.has('caption'));
const dialogLabel = numberLabel ?? alt;

const clampWidths = (widths: number[]): number[] =>
  src ? [...new Set([...widths.filter((w) => w < src.width), src.width])] : [];
---

<figure class:list={['figure', { 'figure--framed': framed }, className]} id={id}>
  <div class="figure__frame">
    {src && (
      <div class:list={['figure__media', mediaClass]} data-figure-zoom={enlarge ? '' : undefined}>
        <Image
          src={src}
          alt={alt}
          widths={clampWidths([480, 720, 960, 1280])}
          sizes={sizes}
          loading={loading}
          decoding="async"
        />
      </div>
    )}
    {inlineSvg && (
      <div
        class:list={['figure__media', 'figure__media--svg', mediaClass]}
        role="img"
        aria-label={alt}
        data-figure-zoom={enlarge ? '' : undefined}
        set:html={inlineSvg}
      />
    )}
    {!hasMedia && (
      <div class:list={['figure__media', mediaClass]}>
        <slot />
      </div>
    )}
    {enlarge && (
      <button
        type="button"
        class="figure__enlarge"
        data-figure-open
        aria-haspopup="dialog"
        data-print="hide"
      >
        <Icon name="lucide:maximize-2" aria-hidden="true" />
        <span class="sr-only">Enlarge {numberLabel ?? 'figure'}</span>
      </button>
    )}
  </div>

  {hasCaption && (
    <figcaption class="figure__caption">
      {numberLabel && <span class="figure__number">{numberLabel}.</span>}
      {caption && <span>{caption}</span>}
      <slot name="caption" />
      {credit && (
        <span class="figure__credit">
          Source:{' '}
          {creditHref ? (
            <a class="link" href={creditHref}>
              {credit}
            </a>
          ) : (
            credit
          )}
        </span>
      )}
    </figcaption>
  )}

  {enlarge && (
    <dialog class="figure__dialog" aria-label={`${dialogLabel}, enlarged`}>
      <div class="figure__dialog-inner">
        <div class="figure__dialog-bar">
          <p class="figure__dialog-title">{numberLabel ?? 'Figure'}</p>
          <button type="button" class="figure__close" data-figure-close>
            <Icon name="lucide:x" aria-hidden="true" />
            <span class="sr-only">Close</span>
          </button>
        </div>
        <div class="figure__dialog-media" data-figure-target>
          {src && (
            <template>
              <Image
                src={src}
                alt={alt}
                widths={clampWidths([960, 1600, 2400])}
                sizes="96vw"
                loading="eager"
                decoding="async"
              />
            </template>
          )}
        </div>
      </div>
    </dialog>
  )}
</figure>

<style>
  .figure {
    display: grid;
    gap: var(--space-sm);
    margin-block: var(--space-lg);
    min-width: 0;
  }

  .figure__frame {
    position: relative;
    min-width: 0;
  }

  .figure--framed .figure__frame {
    padding: var(--space-md);
    border: var(--rule-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .figure__media {
    color: var(--color-foreground); /* ink of theme-aware SVGs (currentColor) */
  }

  .figure__media > :global(img),
  .figure__media > :global(svg) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .figure__media > :global(img) {
    border-radius: var(--radius-sm);
  }

  :global(.js) .figure__media[data-figure-zoom] {
    cursor: zoom-in;
  }

  .figure__enlarge,
  .figure__close {
    display: inline-grid;
    place-items: center;
    width: var(--size-target);
    height: var(--size-target);
    border-radius: var(--radius-full);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);

    & :global(svg) {
      width: var(--size-icon);
      height: var(--size-icon);
    }

    &:hover {
      color: var(--color-foreground);
      background-color: var(--color-sunken);
    }
  }

  .figure__enlarge {
    display: none;
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    background-color: color-mix(in oklab, var(--color-surface) 85%, transparent);
  }

  /* With a mouse, the button appears on hover/focus so it never hides a plot legend;
     on touch screens it stays visible (tapping the figure also enlarges it). */
  @media (hover: hover) {
    .figure__enlarge {
      opacity: 0;
      transition:
        opacity var(--duration-base) var(--ease-standard),
        color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .figure__frame:hover .figure__enlarge,
    .figure__enlarge:focus-visible {
      opacity: 1;
    }
  }

  :global(.js) .figure__enlarge {
    display: inline-grid;
  }

  .figure__caption {
    max-width: var(--container-measure);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-muted);
  }

  .figure__number {
    margin-right: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
  }

  .figure__credit {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
  }

  /* ------------------------------------------------------------- Enlarged view */
  .figure__dialog {
    width: min(96vw, 90rem);
    max-width: none;
    max-height: 94dvh;
    margin: auto;
    padding: 0;
    border: var(--rule-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-foreground);
    box-shadow: var(--shadow-md);
    overscroll-behavior: contain;
  }

  .figure__dialog::backdrop {
    background-color: color-mix(in oklab, var(--color-background) 82%, transparent);
    backdrop-filter: blur(2px);
  }

  .figure__dialog-inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    max-height: calc(94dvh - 2px);
  }

  .figure__dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md);
    border-bottom: var(--rule-width) solid var(--color-border);
  }

  .figure__dialog-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .figure__dialog-media {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: var(--space-md);
    overflow: auto;

    & > :global(img),
    & > :global(svg) {
      display: block;
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: calc(94dvh - var(--size-target) - 2 * var(--space-md) - 1.5rem);
    }

    & > :global(svg) {
      width: 100%;
    }
  }

  @media print {
    .figure--framed .figure__frame {
      padding: 0;
      border: 0;
    }

    .figure__dialog {
      display: none;
    }
  }
</style>

<style is:global>
  html:has(.figure__dialog[open]) {
    overflow: hidden;
  }
</style>

<script>
  /* Click-to-enlarge for <Figure>. Event delegation: registered once, survives page swaps. */
  function fill(dialog: HTMLDialogElement, figure: Element): void {
    const target = dialog.querySelector('[data-figure-target]');
    if (!target || target.querySelector('img, svg')) return;
    const template = target.querySelector('template');
    if (template) {
      target.append(template.content.cloneNode(true));
      return;
    }
    const svg = figure.querySelector('.figure__media svg');
    if (svg) target.append(svg.cloneNode(true));
  }

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    if (target instanceof HTMLDialogElement && target.matches('.figure__dialog')) {
      target.close(); // click on the backdrop
      return;
    }
    if (target.closest('[data-figure-close]')) {
      target.closest('dialog')?.close();
      return;
    }
    const opener = target.closest('[data-figure-open], [data-figure-zoom]');
    const figure = opener?.closest('.figure');
    const dialog = figure?.querySelector<HTMLDialogElement>('.figure__dialog');
    if (!figure || !dialog || dialog.open) return;
    fill(dialog, figure);
    // Focus returns to the element focused before showModal(): make that the button.
    figure.querySelector<HTMLElement>('[data-figure-open]')?.focus({ preventScroll: true });
    dialog.showModal();
  });
</script>
